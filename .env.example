# Copy to .env and change before any real deployment.
# Never commit real credentials.

POSTGRES_USER=hop
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hop
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://hop:changeme@localhost:5432/hop
REDIS_URL=redis://localhost:6379/0

API_HOST=0.0.0.0
API_PORT=8000
# Do not use * in production. List the Expo/web origins that should call this API.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Mobile (Expo). Android emulator typically needs http://10.0.2.2:8000
# Cleartext HTTP is refused by the client except for localhost / 10.0.2.2.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
