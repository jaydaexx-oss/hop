# Copy to .env for local development. Never commit real credentials.

POSTGRES_USER=hop
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD
POSTGRES_DB=hop
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://hop:CHANGE_ME_LOCAL_DEV_PASSWORD@localhost:5432/hop
REDIS_URL=redis://localhost:6379/0

APP_ENV=development
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=text
TRUST_PROXY_HEADERS=false
DOCS_ENABLED=true
METRICS_ENABLED=true
UVICORN_WORKERS=1

# Do not use * in production. List the Expo/web origins that should call this API.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Mobile (Expo). Do not use Expo Go for BLE.
# Simulator: http://127.0.0.1:8000
# Android emulator: http://10.0.2.2:8000
# Physical iPhone (same Wi-Fi): http://<MAC_LAN_IP>:8000  — bind API with --host 0.0.0.0
#   ipconfig getifaddr en0
# Production / TestFlight: https://<API_DOMAIN>
# Cleartext HTTP is refused by release clients except loopback. Dev clients also allow RFC1918 LAN.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
