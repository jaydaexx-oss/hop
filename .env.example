# Copy to .env for local development. Never commit real credentials.
# Homebrew: brew services start postgresql@16 && brew services start redis
# Docker (optional): POSTGRES_PASSWORD is required by infra/docker-compose.yml
# Never point DATABASE_URL at hop-uokqmg / hop-uokqmg-db.

POSTGRES_USER=hop
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_DEV_PASSWORD
POSTGRES_DB=hop
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://hop@localhost:5432/hop
REDIS_URL=redis://localhost:6379/0

APP_ENV=development
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=text
TRUST_PROXY_HEADERS=false
DOCS_ENABLED=true
METRICS_ENABLED=true
UVICORN_WORKERS=1

# Dev-only POST /auth/dev/reset-account-creation-limits (7-tap diagnostics).
# Enabled automatically when APP_ENV is not production; set true locally anyway.
# Never set these on hop-uokqmg (Fly flag stays off).
ENABLE_DEV_RATE_LIMIT_RESET=true
# DEV_RATE_LIMIT_RESET_KEY=  # Fly secret only; never commit
# Clears this request's network/IP mint bucket (5/24h) and optional X-Hop-Install (3/24h).
# Copy-paste against the local API (refuses hop-uokqmg):
#   cd apps/api && npm run reset:account-creation-limits
#   curl -sS -X POST http://127.0.0.1:8000/auth/dev/reset-account-creation-limits
# A Mac curl cannot clear an iPhone's cellular/Wi-Fi IP. For a physical phone, set
# EXPO_PUBLIC_API_URL=http://<MAC_LAN_IP>:8000 and use the in-app diagnostics reset.

# Do not use * in production. List the Expo/web origins that should call this API.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Mobile (Expo). Do not use Expo Go for BLE.
# Simulator: http://127.0.0.1:8000
# Android emulator: http://10.0.2.2:8000
# Physical iPhone (same Wi-Fi): http://<MAC_LAN_IP>:8000  — bind API with --host 0.0.0.0
#   ipconfig getifaddr en0
# Production EAS profiles stay on https://hop-uokqmg.fly.dev (do not change eas.json for local work).
# The app banner shows DEV for local/LAN and PRODUCTION for hop-uokqmg.fly.dev (from URL + /version env).
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
