# Production environment template
# Copy to infra/.env on the VPS (gitignored). Replace every CHANGE_ME.
# Never commit real secrets. This file is not a live deploy.

# --- Public HTTPS ---
API_DOMAIN=api.example.com
API_PUBLIC_URL=https://api.example.com
LETSENCRYPT_EMAIL=ops@example.com

# --- Application ---
APP_ENV=production
APP_VERSION=0.1.0
CORS_ORIGINS=https://app.example.com
DOCS_ENABLED=false
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
UVICORN_WORKERS=2
FORWARDED_ALLOW_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- PostgreSQL (required in production; sqlite is rejected) ---
POSTGRES_USER=hop
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hop
# Compose builds DATABASE_URL from the POSTGRES_* values.
# If you set DATABASE_URL by hand it must be postgresql+psycopg://… on a non-loopback host.

# --- Redis (required in production) ---
# Compose sets REDIS_URL=redis://redis:6379/0

# --- Rate limits (optional) ---
RATE_LIMIT_AUTH=30
RATE_LIMIT_MESSAGE=60

# --- Ports on the VPS (optional) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Backups (optional) ---
BACKUP_RETENTION_DAYS=14
