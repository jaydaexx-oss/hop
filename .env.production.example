# Production environment template
# VPS Compose: copy to infra/.env (gitignored). Replace every CHANGE_ME.
# Fly.io: do not copy this file into git; set secrets with `fly secrets set`
#   (see docs/FLY_DEPLOYMENT.md). Never commit real secrets. Not a live deploy.

# --- Public HTTPS ---
# VPS: DNS hostname. Fly: https://<your-app>.fly.dev (no custom DNS required).
API_DOMAIN=api.example.com
API_PUBLIC_URL=https://api.example.com
LETSENCRYPT_EMAIL=ops@example.com

# --- Application ---
APP_ENV=production
APP_VERSION=0.1.0
CORS_ORIGINS=https://app.example.com
DOCS_ENABLED=false
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
UVICORN_WORKERS=2
FORWARDED_ALLOW_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- PostgreSQL (required in production; sqlite is rejected) ---
POSTGRES_USER=hop
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hop
# Compose builds DATABASE_URL from the POSTGRES_* values.
# Fly: fly postgres attach, then DATABASE_URL must be postgresql+psycopg://… (not sqlite, not localhost).
# Persistent SQLite is not supported on Fly (ephemeral disk) or with UVICORN_WORKERS>=2.

# --- Redis (required in production) ---
# Compose sets REDIS_URL=redis://redis:6379/0
# Fly: fly redis attach (or private .internal Redis). Not localhost.

# --- Fly.io secrets only (leave commented; never commit values) ---
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/hop
# REDIS_URL=redis://hop-redis.internal:6379/0
# API_PUBLIC_URL=https://YOUR-APP.fly.dev
# CORS_ORIGINS=https://YOUR-APP.fly.dev

# --- Rate limits (optional) ---
RATE_LIMIT_AUTH=30
RATE_LIMIT_MESSAGE=60

# --- Ports on the VPS (optional) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Backups (optional) ---
BACKUP_RETENTION_DAYS=14
