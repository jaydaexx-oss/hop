# Copy to apps/mobile/.env (gitignored). Restart Metro / rebuild JS after changing.
# Do not use Expo Go. Native BLE requires a development client (`expo-dev-client`).

# iOS Simulator / this Mac (loopback is this computer):
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Physical iPhone on the same Wi-Fi as the Mac running the API.
# Localhost on the phone is the phone itself and cannot reach your Mac.
# Find the Mac LAN IP:  ipconfig getifaddr en0
# Then set (example):
# EXPO_PUBLIC_API_URL=http://192.168.1.23:8000
#
# The API must bind all interfaces:  uvicorn ... --host 0.0.0.0 --port 8000
# Development builds allow cleartext HTTP only to loopback and RFC1918 LAN IPs.
# iOS ATS local-networking is enabled for that LAN HTTP path.
#
# Production / TestFlight (HTTPS only). Release builds refuse LAN cleartext:
# EXPO_PUBLIC_API_URL=https://api.example.com
#
# Android emulator (host machine from the AVD):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000
