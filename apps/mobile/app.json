{
  "expo": {
    "name": "HOP",
    "slug": "hop",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hop",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.hop.mobile",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "HOP uses Bluetooth to find nearby HOP users and exchange a message when Nearby is open.",
        "NSBluetoothPeripheralUsageDescription": "HOP uses Bluetooth to be discoverable by nearby HOP users while Nearby is open.",
        "NSMicrophoneUsageDescription": "HOP records short voice messages you send to other HOP users."
      }
    },
    "android": {
      "package": "app.hop.mobile",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B0F14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0F14"
        }
      ],
      "expo-secure-store",
      [
        "expo-av",
        {
          "microphonePermission": "HOP records short voice messages you send to other HOP users."
        }
      ],
      [
        "munim-bluetooth",
        {
          "androidBluetoothPermissions": ["scan", "connect", "advertise"],
          "localNetworkUsageDescription": "HOP Nearby uses Bluetooth Low Energy, not your local network, to find nearby HOP users."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
