# Production environment template for infra/docker-compose.prod.yml
# Copy to infra/.env on the VPS and replace every CHANGE_ME value.
# Never commit infra/.env.
# Fly.io (recommended PaaS): docs/FLY_DEPLOYMENT.md — do not use this compose file on Fly.

# --- Domain & TLS ---
API_DOMAIN=api.example.com
API_PUBLIC_URL=https://api.example.com
LETSENCRYPT_EMAIL=ops@example.com

# --- Application ---
APP_VERSION=0.1.0
CORS_ORIGINS=https://app.example.com
DOCS_ENABLED=false
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
UVICORN_WORKERS=2
FORWARDED_ALLOW_IPS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

# --- PostgreSQL (required) ---
POSTGRES_USER=hop
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hop

# --- Rate limits (optional) ---
RATE_LIMIT_AUTH=30
RATE_LIMIT_MESSAGE=60

# --- Ports exposed on the VPS (optional) ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Backups (optional) ---
BACKUP_RETENTION_DAYS=14
